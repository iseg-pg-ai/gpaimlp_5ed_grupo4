# Configuração partilhável; copiar para .env apenas para alterar os valores.
# As credenciais AWS vêm da função IAM da sessão SageMaker.
AWS_REGION=eu-west-1
BLU_AGENT_PROVIDER=bedrock
BEDROCK_MODEL_ID=eu.amazon.nova-pro-v1:0
BLU_AGENT_MAX_OUTPUT_TOKENS=1800
BLU_AGENT_TIMEOUT_SECONDS=35

# Produção exige um teto mensal aprovado e preços atuais por milhão de tokens.
# Confirmar os valores na tabela oficial do fornecedor antes do deployment.
# BLU_AGENT_MONTHLY_BUDGET_USD=VALOR_APROVADO
# BLU_AGENT_RATES_JSON={"modelo-aprovado":{"input":PRECO_USD_MILHAO,"output":PRECO_USD_MILHAO}}

# Produção atrás do ALB autenticado. Estes identificadores são injetados pela
# infraestrutura; não ativar alb-cognito parcialmente nem confiar em headers locais.
# BLU_IDENTITY_MODE=alb-cognito
# BLU_ALB_ARN=arn:aws:elasticloadbalancing:eu-west-1:123456789012:loadbalancer/app/...
# BLU_COGNITO_USER_POOL_ID=eu-west-1_Example
# BLU_COGNITO_CLIENT_ID=example
# BLU_COGNITO_ISSUER=https://cognito-idp.eu-west-1.amazonaws.com/eu-west-1_Example

# O launcher define BLU_DATA_DIR, BLU_WAREHOUSE_DIR, BLU_EXPORT_DIR e
# BLU_OPERATIONAL_DIR dentro da cache temporária. Não os fixar no .env normal.
# BLU_BACKUP_DIR=/caminho/externo/blu-backups

# Persistência S3 autorizada; usa IAM, nunca chaves neste ficheiro.
# BLU_DATA_S3_BUCKET=blu-dmc-data-conta-regiao
# BLU_BACKUP_S3_BUCKET=blu-backups-existente
# BLU_BACKUP_S3_PREFIX=blu-backups
# BLU_ENVIRONMENT=development
# BLU_BACKUP_S3_KMS_KEY_ID=alias/chave-existente

# Notificações do Monitoring. Ativar apenas depois de criar, subscrever e testar
# um tópico SNS privado; o ARN não contém credenciais.
# BLU_MONITORING_NOTIFICATIONS_ENABLED=true
# BLU_MONITORING_SNS_TOPIC_ARN=arn:aws:sns:eu-west-1:123456789012:blu-monitoring

# Fontes locais para PDFs. Usar caminhos absolutos; TTC CJK exige a face interna.
# BLU_PDF_FONT=/caminho/para/fonte-latina.ttf
# BLU_PDF_CJK_FONT=/caminho/para/NotoSansCJK-Regular.ttc
# BLU_PDF_CJK_FACE=NotoSansCJKsc-Regular
