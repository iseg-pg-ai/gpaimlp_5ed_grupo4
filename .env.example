# Configuração partilhável; copiar para .env apenas para alterar os valores.
# As credenciais AWS vêm da função IAM da sessão SageMaker.
AWS_REGION=eu-north-1
BEDROCK_MODEL_ID=eu.amazon.nova-lite-v1:0
AGENT_TEMPERATURE=0.2
AGENT_MAX_TOKENS=4096

# Em containers, apontar estes caminhos para volumes persistentes.
# BLU_DATA_DIR=/mnt/blu/data
# BLU_EXPORT_DIR=/mnt/blu/exports/itineraries
# BLU_OPERATIONAL_DIR=/mnt/blu/exports/portal-persistence
# BLU_BACKUP_DIR=/mnt/blu-backups

# Cópia remota opcional em infraestrutura S3 existente; usa IAM, nunca chaves aqui.
# BLU_BACKUP_S3_BUCKET=blu-backups-existente
# BLU_BACKUP_S3_PREFIX=blu-backups
# BLU_ENVIRONMENT=development
# BLU_BACKUP_S3_KMS_KEY_ID=alias/chave-existente
