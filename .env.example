# Configuração partilhável; copiar para .env apenas para alterar os valores.
# As credenciais AWS vêm da função IAM da sessão SageMaker.
AWS_REGION=eu-west-1
BEDROCK_MODEL_ID=eu.amazon.nova-pro-v1:0
AGENT_TEMPERATURE=0.2
AGENT_MAX_TOKENS=4096

# O launcher define BLU_DATA_DIR, BLU_WAREHOUSE_DIR, BLU_EXPORT_DIR e
# BLU_OPERATIONAL_DIR dentro da cache temporária. Não os fixar no .env normal.
# BLU_BACKUP_DIR=/caminho/externo/blu-backups

# Persistência S3 autorizada; usa IAM, nunca chaves neste ficheiro.
# BLU_DATA_S3_BUCKET=blu-dmc-data-conta-regiao
# BLU_BACKUP_S3_BUCKET=blu-backups-existente
# BLU_BACKUP_S3_PREFIX=blu-backups
# BLU_ENVIRONMENT=development
# BLU_BACKUP_S3_KMS_KEY_ID=alias/chave-existente

# Fontes locais para PDFs. Usar caminhos absolutos; TTC CJK exige a face interna.
# BLU_PDF_FONT=/caminho/para/fonte-latina.ttf
# BLU_PDF_CJK_FONT=/caminho/para/NotoSansCJK-Regular.ttc
# BLU_PDF_CJK_FACE=NotoSansCJKsc-Regular
