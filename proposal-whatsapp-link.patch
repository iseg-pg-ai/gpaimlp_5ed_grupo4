diff --git a/frontend/intranet/proposal-links.mjs b/frontend/intranet/proposal-links.mjs
new file mode 100644
index 0000000..0b6b19f
--- /dev/null
+++ b/frontend/intranet/proposal-links.mjs
@@ -0,0 +1,23 @@
+// WhatsApp text must contain the real URL; Markdown labels are not hyperlinks there.
+export function proposalShareUrl(value, portal) {
+  try {
+    const url = new URL(value);
+    const base = new URL(portal);
+    return url.protocol === 'https:' && url.origin === base.origin && !url.username && !url.password
+      && !url.search && !url.hash && /^\/(share\/[\w-]+|api\/shares\/[\w-]+\/document)$/.test(url.pathname)
+      ? url.href : '';
+  } catch { return ''; }
+}
+
+export function embedProposalLink(text, url, previous = '') {
+  let result = String(text ?? '').replaceAll('[link da proposta]', url);
+  if (previous && previous !== url) result = result.split(previous).join(url);
+  if (!result.includes(url)) result = `${result.trimEnd()}\n\nYour proposal: ${url}`.trim();
+  return result;
+}
+
+export function proposalPayload(text, url, extra = '', limit = 1000) {
+  const result = embedProposalLink(text, url) + extra;
+  if (result.length > limit) throw new Error(`A mensagem tem ${result.length} caracteres (máximo ${limit}). Encurte o texto; o link não será cortado.`);
+  return result;
+}
diff --git a/proposal-links.test.mjs b/proposal-links.test.mjs
new file mode 100644
index 0000000..54e770a
--- /dev/null
+++ b/proposal-links.test.mjs
@@ -0,0 +1,20 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { proposalShareUrl, embedProposalLink, proposalPayload } from './frontend/intranet/proposal-links.mjs';
+const portal = 'https://d3804amye1jw31.cloudfront.net/';
+const link = `${portal}share/test-token`;
+test('only real share routes on the configured HTTPS portal are accepted', () => {
+  assert.equal(proposalShareUrl(link, portal), link);
+  assert.equal(proposalShareUrl(`${portal}api/shares/test-token/document`, portal), `${portal}api/shares/test-token/document`);
+  for (const bad of [portal+'catalog', 'https://evil.example/share/test-token', 'http://d3804amye1jw31.cloudfront.net/share/test-token', link+'?redirect=evil', 'javascript:alert(1)']) assert.equal(proposalShareUrl(bad, portal), '');
+});
+test('inserts URL into edited messages, replacing placeholders without duplication', () => {
+  assert.equal(embedProposalLink('Custom intro\nYour proposal: [link da proposta]', link), `Custom intro\nYour proposal: ${link}`);
+  const message = embedProposalLink('Custom intro', link);
+  assert.equal(embedProposalLink(message, link), message);
+  assert.equal(embedProposalLink(message, link+'2', link), `Custom intro\n\nYour proposal: ${link}2`);
+});
+test('payload preserves the full URL and refuses truncation with recommendation text', () => {
+  assert.ok(proposalPayload('Hello',link).endsWith(link));
+  assert.throws(()=>proposalPayload('x'.repeat(970),link,' recommended service'),/máximo 1000/);
+});
