{
  "name": "blu-infra",
  "private": true,
  "type": "module",
  "scripts": {
    "synth": "node app.mjs",
    "synth:aws": "node aws-app.mjs",
    "synth:split": "node aws-split-app.mjs",
    "synth:cloud": "node aws-split-app.mjs",
    "deploy:cloud": "cdk deploy --all --app \"node aws-split-app.mjs\"",
    "synthetic:cloud": "node scripts/generate-synthetic-interactions.mjs",
    "pretest": "node app.mjs",
    "test": "node --test tests/*.test.mjs",
    "deploy:local": "node deploy-local.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-cloudformation": "^3.900.0",
    "aws-cdk-lib": "^2.220.0",
    "constructs": "^10.4.0"
  },
  "devDependencies": {
    "aws-cdk": "^2.1030.0"
  }
}
