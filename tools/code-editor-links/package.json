{
  "name": "blu-workspace-links",
  "displayName": "BLU Workspace Links",
  "description": "Abre as interfaces BLU através do encaminhamento nativo do Code Editor atual.",
  "version": "0.1.2",
  "publisher": "blu-local",
  "engines": { "vscode": "^1.90.0" },
  "main": "./extension.cjs",
  "extensionKind": ["workspace"],
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "commands": [
      { "command": "blu.openInterfaces", "title": "BLU: Abrir interfaces deste workspace" },
      { "command": "blu.forwardInterfaces", "title": "BLU: Registar portas deste workspace" }
    ]
  }
}
